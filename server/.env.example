# Server
PORT=3000
NODE_ENV=development

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/travelo

# Auth (required) - use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Token and cookie lifetime (e.g. 15m, 12h, 1d, 7d)
JWT_EXPIRES_IN=1d

# UploadThing (required for document, receipt and photo uploads)
UPLOADTHING_TOKEN=your-uploadthing-token

# Allowed client origin(s) for CORS and Socket.IO, comma-separated
CLIENT_URL=http://localhost:5173

# Set to true when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=false
