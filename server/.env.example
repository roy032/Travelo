# Server
PORT=3000
NODE_ENV=development

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/travelo

# Auth (required) - use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Token and cookie lifetime (e.g. 15m, 12h, 1d, 7d)
JWT_EXPIRES_IN=1d

# UploadThing (required for document, receipt and photo uploads)
UPLOADTHING_TOKEN=your-uploadthing-token

# Allowed client origin(s) for CORS and Socket.IO, comma-separated
CLIENT_URL=http://localhost:5173

# Set to true when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=false

# Comma-separated emails that are made admins when they sign in.
# Register the account first; signing up never grants admin.
ADMIN_EMAILS=

# Email (password reset, email confirmation, join request updates)
# console (default) writes emails to the server log; use resend or smtp to send them
EMAIL_PROVIDER=console
EMAIL_FROM="Travelo <no-reply@example.com>"
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_PROVIDER=smtp: either SMTP_URL=smtps://user:pass@smtp.example.com:465
# or SMTP_HOST, SMTP_PORT (default 587), SMTP_USER, SMTP_PASS, SMTP_SECURE
# SMTP_URL=
# Base URL for links in emails; defaults to SITE_URL, then the first CLIENT_URL
# APP_URL=

# Optional: Sentry error tracking (leave empty to disable)
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Fraction of requests to trace for performance monitoring, 0 to 1
# SENTRY_TRACES_SAMPLE_RATE=0

# Optional rate limit overrides
# Sign-up/sign-in attempts per IP and per account every 15 minutes
# AUTH_RATE_LIMIT_MAX=10
# API requests per IP per minute
# API_RATE_LIMIT_MAX=300
